PORT=3000
# Production me isko lamba random string rakhein
APP_SECRET=change-this-to-a-long-random-secret
DB_PATH=./data/pappu.db
# Har kitne ms me naya price tick aayega
TICK_MS=1000
# Ek candle kitne seconds ki (demo ke liye 5s; real market ke liye 60)
CANDLE_SECONDS=5
# Default admin (sirf pehli baar DB banne par use hota hai)
ADMIN_EMAIL=admin@pappubhai.ai
ADMIN_PASSWORD=admin123
# Broker aur API keys ab Admin Panel → 🏦 Brokers / 🔑 API Keys se add hote hain.
# Wahan saved secrets isi APP_SECRET se encrypt hote hain - APP_SECRET badla to keys dobara daalni padengi.

# Chart ke bade time frame (5m/15m/1h) ke liye itni purani candle history chahiye (default 3600 = 5 ghante)
# HISTORY_CANDLES=3600
